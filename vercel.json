{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/asset-versions.mjs check-build && node tools/build-site.mjs",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(admin|mypage|instructor|about|submissions)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/instructor/c/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(dl|dl\\.html)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/r/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/r/c5f532590df7/:file(admin-fal-watch-lib\\.js|admin-fal-watch\\.js|admin-lib\\.js|admin-submissions\\.js|admin-workshop-lib\\.js|admin-workshop\\.js|admin\\.js|auth-storage\\.js|cohort-close-lib\\.js|dl-lib\\.js|dl\\.css|dl\\.js|gsi-button\\.css|instructor-list-lib\\.js|instructor-list\\.js|instructor\\.js|mypage-lib\\.js|mypage-share\\.js|mypage-submissions\\.js|mypage\\.js|probe-background-worker\\.js|probe-background\\.css|probe-background\\.js|qr-code\\.js|redirect-check\\.js|share-lib\\.js|site-nav\\.css|site-nav\\.js|stage-lib\\.js|stage-timer-lib\\.js|stage-timer\\.js|storage-usage-lib\\.js|studio\\.css|submissions-lib\\.js|submissions\\.js|topbar-height\\.js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/canvas(/.*)?",
      "headers": [{ "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-9bV5uQZjk9iIYEZxpwPmNXHikPutSLJIq55fhKbeVNY='; style-src 'self' 'unsafe-inline'; connect-src 'self' https://tnzwhwitgnzoehbjrmoy.supabase.co wss://tnzwhwitgnzoehbjrmoy.supabase.co blob: data:; img-src 'self' https://tnzwhwitgnzoehbjrmoy.supabase.co blob: data:; media-src 'self' https://tnzwhwitgnzoehbjrmoy.supabase.co blob: data:; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }]
    },
    {
      "source": "/canvas/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/canvas(/(?!assets/).*)?",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "rewrites": [
    { "source": "/r/c5f532590df7/:file(admin-fal-watch-lib\\.js|admin-fal-watch\\.js|admin-lib\\.js|admin-submissions\\.js|admin-workshop-lib\\.js|admin-workshop\\.js|admin\\.js|auth-storage\\.js|cohort-close-lib\\.js|dl-lib\\.js|dl\\.css|dl\\.js|gsi-button\\.css|instructor-list-lib\\.js|instructor-list\\.js|instructor\\.js|mypage-lib\\.js|mypage-share\\.js|mypage-submissions\\.js|mypage\\.js|probe-background-worker\\.js|probe-background\\.css|probe-background\\.js|qr-code\\.js|redirect-check\\.js|share-lib\\.js|site-nav\\.css|site-nav\\.js|stage-lib\\.js|stage-timer-lib\\.js|stage-timer\\.js|storage-usage-lib\\.js|studio\\.css|submissions-lib\\.js|submissions\\.js|topbar-height\\.js)", "destination": "/:file" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/mypage", "destination": "/index.html" },
    { "source": "/mypage.html", "destination": "/index.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/submissions", "destination": "/submissions.html" },
    { "source": "/dl", "destination": "/dl.html" },
    { "source": "/instructor", "destination": "/instructor.html" },
    { "source": "/instructor/c/:id", "destination": "/instructor.html" },
    { "source": "/canvas", "destination": "/canvas/index.html" },
    { "source": "/canvas/((?!assets/).*)", "destination": "/canvas/index.html" }
  ]
}
