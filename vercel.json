{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(admin|mypage|instructor)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/canvas(/.*)?",
      "headers": [{ "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-9bV5uQZjk9iIYEZxpwPmNXHikPutSLJIq55fhKbeVNY='; style-src 'self' 'unsafe-inline'; connect-src 'self' https://tnzwhwitgnzoehbjrmoy.supabase.co wss://tnzwhwitgnzoehbjrmoy.supabase.co blob: data:; img-src 'self' https://tnzwhwitgnzoehbjrmoy.supabase.co blob: data:; media-src 'self' https://tnzwhwitgnzoehbjrmoy.supabase.co blob: data:; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }]
    },
    {
      "source": "/canvas/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/canvas(/(?!assets/).*)?",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/mypage", "destination": "/mypage.html" },
    { "source": "/instructor", "destination": "/instructor.html" },
    { "source": "/canvas", "destination": "/canvas/index.html" },
    { "source": "/canvas/((?!assets/).*)", "destination": "/canvas/index.html" }
  ]
}
